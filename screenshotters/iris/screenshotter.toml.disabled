slug = "iris"

emulator_repo = "https://github.com/allkern/iris.git"
emulator_default_branch = "iop-cached"

archive_slug = "iris"

rom_subdir = "Sony - PlayStation 2/ps2-downloads"

supported_direct = ["iso", "bin", "cue", "chd", "cso", "zso"]
supported_archives = ["zip"]

[runner]
requires_gpu = true
gpu = "nvidia"
max_parallel_games = 1
output_mode = "single-png"
timeout_seconds = 1200
docker_mounts = [
    "/tmp/.X11-unix:/tmp/.X11-unix",
    "/run/user/1000:/run/user/1000:ro",
    "/usr/share/glvnd/egl_vendor.d/10_nvidia.json:/usr/share/glvnd/egl_vendor.d/10_nvidia.json:ro",
]

[runner.docker_env]
NVIDIA_DRIVER_CAPABILITIES = "all"
DISPLAY = ":0"
XAUTHORITY = "/run/user/1000/.mutter-Xwaylandauth.J1AYP3"
SDL_VIDEODRIVER = "x11"
SDL_AUDIODRIVER = "dummy"
VK_ICD_FILENAMES = "/etc/vulkan/icd.d/nvidia_icd.json"
__NV_PRIME_RENDER_OFFLOAD = "1"
__VK_LAYER_NV_optimus = "NVIDIA_only"
__GLX_VENDOR_LIBRARY_NAME = "nvidia"

[iris]
binary = "/usr/local/bin/iris"
bios = "/config/bios/scph39001.bin"
run_seconds = 20
grace_seconds = 30
